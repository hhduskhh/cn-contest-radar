# 复制本文件为 .env 后修改。.env 不要提交到版本库。

# 网页登录账号（HTTP Basic）。手机浏览器访问时会弹出输入框。
APP_USER=admin
APP_PASSWORD=改成你自己的密码

# 监听端口
PORT=8000

# 定时爬取时间（cron 表达式，Asia/Shanghai 时区）
# 默认每周一 03:17 —— 避开整点，减少与其它定时任务撞车
CRAWL_CRON_DAY_OF_WEEK=mon
CRAWL_CRON_HOUR=3
CRAWL_CRON_MINUTE=17

# 是否在启动时立即跑一次增量爬取（1=是，0=否）
CRAWL_ON_STARTUP=0
